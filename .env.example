# ==============================================================================
# BenchLab Environment Configuration Template
# SPEC Version: 1.0
# NOTE: Copy this file to .env and adjust values as needed for your environment.
# DO NOT commit .env with production or sensitive secrets to version control.
# ==============================================================================

# Project Metadata
PROJECT_NAME=benchlab
ENVIRONMENT=development
SPEC_VERSION=1.0

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Pinned: PostgreSQL 17.2-alpine)
# ------------------------------------------------------------------------------
POSTGRES_USER=benchlab_user
POSTGRES_PASSWORD=benchlab_dev_password_change_me
POSTGRES_DB=benchlab_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_WORK_MEM=16MB

# ------------------------------------------------------------------------------
# MongoDB Configuration (Pinned: MongoDB 8.0.4)
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=benchlab_user
MONGO_INITDB_ROOT_PASSWORD=benchlab_dev_password_change_me
MONGO_DB=benchlab_db
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# Container Resource Quota (Refined for Host: 2 Physical Cores, 4 Threads, 16GB RAM)
# ------------------------------------------------------------------------------
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEM_LIMIT=2048m

# ------------------------------------------------------------------------------
# API & Runner Server Settings
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
RESULTS_DIR=results
DATASETS_DIR=data

# ------------------------------------------------------------------------------
# Frontend Dashboard Settings
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Benchmark Protocol Defaults
# ------------------------------------------------------------------------------
DEFAULT_SEED=42
SERVER_TIMEOUT_SECONDS=30
CLIENT_TIMEOUT_SECONDS=35
PERCENTILE_METHOD=linear
